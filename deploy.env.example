# Copy to deploy.env (git-ignored) and fill in. Used by scripts/build-push.sh and scripts/deploy.sh.

# SWR image registry path: swr.<region>.<swr-domain>/<organization>
REGISTRY=swr.region-1.example.com/pardis-shop
TAG=1.0.0

# Public hostname served by ELB + Ingress (Cloud DNS record points to the ELB EIP)
DOMAIN=shop.example.com

# IngressClass of the ingress add-on installed in CCE (kubectl get ingressclass)
INGRESS_CLASS=nginx

# Image pull secret for SWR in the pardis-shop namespace (CCE usually provides "default-secret")
PULL_SECRET=default-secret

# OBS endpoint host (without https://) and region
OBS_ENDPOINT=obs.region-1.example.com
OBS_REGION=region-1

# Create 4 demo products on first deploy (true/false)
SEED_DEMO_DATA=true
