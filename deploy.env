# Copy to deploy.env (git-ignored). Used by scripts/build-push.sh and scripts/deploy.sh.

# SWR image registry path
REGISTRY=swr.me-ptp-1.mypardiscloud.com/group_c
TAG=latest

# Public hostname served by ELB + Ingress
DOMAIN=shop.prsp.ir

# CCE ELB Ingress
INGRESS_CLASS=cce
ELB_ID=be20b532-9a0e-4bff-8139-03a548926c14
ELB_CLASS=performance

# ELB server certificate ID (ELB console -> Certificates). Empty = HTTP only.
TLS_CERT_ID=PUT-CERTIFICATE-ID-HERE

# Image pull secret for SWR
PULL_SECRET=default-secret

# OBS endpoint host (without https://) and region
OBS_ENDPOINT=obs.me-ptp-1.mypardiscloud.com
OBS_REGION=me-ptp-1

# OBS bucket names (must already exist)
OBS_BUCKET_IMAGES=groupc-ecommerce-images
OBS_BUCKET_INVOICES=groupc-ecommerce-invoices

# CCE Turbo: security group for all app pods and the migrate Jobs
POD_SG_ID=4c8ff9ef-ae8b-4a28-b6b4-e81a4c4eff76

# Create 4 demo products on first deploy
SEED_DEMO_DATA=true